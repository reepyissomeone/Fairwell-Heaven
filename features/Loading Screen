--// FAIRWELL HEAVEN
--// Loading Screen

local Players = game:GetService("Players")

local LoadingScreen = {
    Name = "Loading Screen",
    Description = "Fairwell Heaven loading screen."
}

function LoadingScreen.Start(self, Hub)

    print("[Fairwell Heaven] LoadingScreen.Start()")

    local Player = Players.LocalPlayer

    if not Player then
        warn("[Fairwell Heaven] LocalPlayer not found.")
        return
    end

    local PlayerGui = Player:WaitForChild("PlayerGui")

    -- Remove old copy
    local Old = PlayerGui:FindFirstChild("FairwellHeaven_Loading")
    if Old then
        Old:Destroy()
    end

    -- ScreenGui
    local Gui = Instance.new("ScreenGui")
    Gui.Name = "FairwellHeaven_Loading"
    Gui.ResetOnSpawn = false
    Gui.IgnoreGuiInset = true
    Gui.DisplayOrder = 999999
    Gui.Parent = PlayerGui

    -- Main panel
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.Position = UDim2.fromScale(0.5, 0.5)
    Main.Size = UDim2.fromScale(0.75, 0.5)

    -- #100D69
    Main.BackgroundColor3 = Color3.fromRGB(16, 13, 105)
    Main.BorderSizePixel = 0
    Main.Parent = Gui

    -- #1B93E3 outline
    local Outline = Instance.new("UIStroke")
    Outline.Color = Color3.fromRGB(27, 147, 227)
    Outline.Thickness = 4
    Outline.Parent = Main

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 12)
    Corner.Parent = Main

    -- Loading text
    local Text = Instance.new("TextLabel")
    Text.Name = "Loading"
    Text.BackgroundTransparency = 1
    Text.Size = UDim2.fromScale(1, 1)
    Text.Position = UDim2.fromScale(0, 0)

    Text.Text = "LOADING"
    Text.TextColor3 = Color3.fromRGB(255, 255, 255)
    Text.TextScaled = true
    Text.Font = Enum.Font.GothamBold

    Text.Parent = Main

    self.Gui = Gui

    print("[Fairwell Heaven] Loading UI created successfully.")

end

function LoadingScreen.Stop(self, Hub)

    if self.Gui then
        self.Gui:Destroy()
        self.Gui = nil
    end

end

return LoadingScreen